{
  "name": "berkeley-wayfinder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:nav": "pnpm --filter @wf/nav dev",
    "dev:author": "pnpm --filter @wf/author dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "routes": "pnpm --filter @wf/routing exec tsx src/print-routes.ts"
  }
}
