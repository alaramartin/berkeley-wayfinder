{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "osmWayId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "footprint": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sortIndex": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "sortIndex"
        ]
      }
    },
    "shafts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stair",
              "elevator"
            ]
          },
          "name": {
            "type": "string"
          },
          "nodeIds": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
            }
          },
          "stepCounts": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "nodeIds"
        ]
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "a": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "b": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "corridor",
              "stair",
              "elevator",
              "outdoor"
            ]
          },
          "polyline": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "accessible": {
            "type": "boolean"
          },
          "access": {
            "default": "open",
            "type": "string",
            "enum": [
              "open",
              "card",
              "hours",
              "locked"
            ]
          },
          "verified": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "a",
          "b",
          "kind",
          "accessible"
        ]
      }
    },
    "entrances": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "name": {
            "type": "string"
          },
          "accessible": {
            "type": "boolean"
          },
          "verified": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nodeId",
          "name",
          "accessible"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "osmWayId",
    "origin",
    "footprint",
    "levels"
  ]
}
