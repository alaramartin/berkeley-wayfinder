{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buildingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    },
    "referenceLevel": {
      "type": "string"
    },
    "levels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rotationHint": {
            "default": 0,
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "anchors": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "dst": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "src",
                "dst"
              ]
            }
          },
          "transform": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotation": {
                    "type": "number"
                  },
                  "tx": {
                    "type": "number"
                  },
                  "ty": {
                    "type": "number"
                  }
                },
                "required": [
                  "scale",
                  "rotation",
                  "tx",
                  "ty"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rms": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "transform",
          "rms"
        ]
      }
    },
    "osm": {
      "type": "object",
      "properties": {
        "wayId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "lat",
                "lon"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "dst": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "src",
              "dst"
            ]
          }
        },
        "transform": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rotation": {
                  "type": "number"
                },
                "tx": {
                  "type": "number"
                },
                "ty": {
                  "type": "number"
                }
              },
              "required": [
                "scale",
                "rotation",
                "tx",
                "ty"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rms": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "wayId",
        "origin",
        "transform",
        "rms"
      ]
    }
  },
  "required": [
    "buildingId",
    "referenceLevel",
    "levels",
    "osm"
  ]
}
