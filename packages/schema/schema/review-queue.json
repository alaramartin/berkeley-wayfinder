{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buildingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    },
    "levelId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "room-number",
              "alias",
              "icon",
              "restroom-gender"
            ]
          },
          "crop": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "value",
                "confidence"
              ]
            }
          },
          "targetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "resolved": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "at"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "crop",
          "candidates",
          "targetId"
        ]
      }
    }
  },
  "required": [
    "buildingId",
    "levelId",
    "items"
  ]
}
