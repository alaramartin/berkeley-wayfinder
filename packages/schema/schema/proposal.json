{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buildingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    },
    "levelId": {
      "type": "string"
    },
    "imageSize": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "generatedAt": {
      "type": "string"
    },
    "editedAt": {
      "type": "string"
    },
    "pipelineVersion": {
      "type": "string"
    },
    "outline": {
      "anyOf": [
        {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "voids": {
      "default": [],
      "type": "array",
      "items": {
        "minItems": 3,
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "junction",
              "door",
              "stair",
              "elevator",
              "entrance"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "kind",
          "confidence"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "a": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "b": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "corridor",
              "stair",
              "elevator",
              "outdoor"
            ]
          },
          "polyline": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "a",
          "b",
          "kind",
          "polyline",
          "confidence"
        ]
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "regionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "number": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "numberConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "classroom",
              "computer-lab",
              "seminar",
              "library",
              "office",
              "restroom",
              "lactation",
              "auditorium",
              "stair",
              "elevator",
              "service",
              "other"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "polygon": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "doors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "edgeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
                },
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "edgeId",
                "t",
                "side",
                "confidence"
              ]
            }
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "restroom": {
            "type": "object",
            "properties": {
              "gender": {
                "type": "string",
                "enum": [
                  "men",
                  "women",
                  "all"
                ]
              },
              "accessible": {
                "type": "boolean"
              }
            },
            "required": [
              "gender",
              "accessible"
            ]
          }
        },
        "required": [
          "id",
          "number",
          "numberConfidence",
          "category",
          "group",
          "polygon",
          "doors"
        ]
      }
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "exit",
              "accessible",
              "gender-inclusive-restroom",
              "dwa",
              "evac-chair",
              "you-are-here",
              "restroom-men",
              "restroom-women"
            ]
          },
          "at": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "kind",
          "at",
          "confidence"
        ]
      }
    },
    "entrances": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
          },
          "name": {
            "type": "string"
          },
          "accessible": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "exit-icon",
                "accessible-icon",
                "corridor-end"
              ]
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "nodeId",
          "accessible",
          "evidence",
          "confidence"
        ]
      }
    },
    "directory": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "room",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "buildingId",
    "levelId",
    "imageSize",
    "generatedAt",
    "pipelineVersion",
    "outline",
    "nodes",
    "edges",
    "rooms",
    "icons"
  ]
}
